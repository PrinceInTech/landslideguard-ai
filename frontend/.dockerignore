# LandslideGuard AI - frontend image (build context: ./frontend)

# Never copy host dependencies: they may contain platform-specific native
# binaries (esbuild/rollup) that break the container build.
node_modules/
dist/
.vite/

# Local environment overrides must not leak into the image build.
.env
.env.local
.env.*.local

# Not needed inside the image.
Dockerfile
.dockerignore
README.md

npm-debug.log*
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/