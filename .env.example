# LandslideGuard AI - environment configuration
#
# Copy to `.env` in the project root and adjust. Every variable is optional:
# with no `.env` at all the app boots on safe local defaults (SQLite, DEMO
# weather, localhost CORS, a generated model path derived from the repo layout).
#
#   cp .env.example .env
#
# NOTE: keep real secrets OUT of version control. `.env` is git-ignored;
# `.env.example` is tracked.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# DEMO = deterministic simulated weather (no external calls, works offline).
# LIVE = call OpenWeatherMap when a key is present, fall back to DEMO otherwise.
DATA_MODE=DEMO

# FastAPI debug mode. Leave false in production.
DEBUG=false

# development | production
# In `production` the app refuses to start if JWT_SECRET is left at the default
# or DEMO_ADMIN_PASSWORD is still "admin123".
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Signs JWT access tokens. MUST be overridden in production.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-landslideguard-demo-secret

ACCESS_TOKEN_EXPIRE_MINUTES=480

# Password hashing uses the `bcrypt` library directly at its default work
# factor (12). There is no env override; change it in
# backend/app/services/auth_service.py if you need to.

# ---------------------------------------------------------------------------
# Demo admin account (seeded only when the users table is empty)
# ---------------------------------------------------------------------------
DEMO_ADMIN_EMAIL=admin@landslideguard.ai

# WARNING: the default below is intentionally weak and is only accepted while
# ENVIRONMENT=development. Production startup fails if it is left unchanged.
DEMO_ADMIN_PASSWORD=admin123

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave DATABASE_URL unset to use the default SQLite file inside backend/.
#
# Do NOT set a *relative* path here. SQLite resolves relative paths against the
# process working directory, which differs between a local run (repo root) and
# the container (/app) - a relative value can silently point at a
# non-existent directory. Use an absolute path if you override it, e.g.
#   DATABASE_URL=sqlite:////app/data/landslideguard.db        (container)
#   DATABASE_URL=sqlite:///D:/PROJECTS/landslideguard-ai/backend/landslideguard.db
#
# The app currently speaks SQLAlchemy + SQLite only; there is no repository
# abstraction layer, so other engines are not plug-and-play.
# DATABASE_URL=sqlite:///backend/landslideguard.db

# ---------------------------------------------------------------------------
# Filesystem locations
# ---------------------------------------------------------------------------
# Normally auto-detected by walking up from the backend directory to the folder
# containing data/ and ml/. Override only when the layout differs (e.g. a PaaS
# with a read-only filesystem, where you would point these at /tmp).
# DATA_DIR=/app/data
# MODEL_DIR=/app/ml/model
# MODEL_PATH=/app/ml/model/landslide_model.joblib
# PREPROCESSOR_PATH=/app/ml/model/preprocessors.joblib
# TRAIN_SCRIPT=/app/ml/train.py

# ---------------------------------------------------------------------------
# Weather API (optional - required only for DATA_MODE=LIVE)
# ---------------------------------------------------------------------------
# Free key: https://openweathermap.org/api
# If unset, the app transparently uses DEMO weather.
# OPENWEATHER_API_KEY=

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins. Only needed when a browser
# calls the API cross-origin; the Docker nginx image and the Vite dev proxy both
# serve the API same-origin, so this can stay unset in most deployments.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Frontend build-time configuration (Vite)
# ---------------------------------------------------------------------------
# Read at BUILD time by frontend/vite.config.js, so it must be passed as
# --build-arg (see frontend/Dockerfile) or placed in frontend/.env.
# Leave empty to use the dev/preview proxy (correct for local + Docker).
# Set to an absolute URL to call a separately hosted API, e.g. a Render backend.
# VITE_API_URL=https://landslideguard-api.onrender.com